# ==============================================================================
# MIT PLACEMENT MANAGEMENT PORTAL & MODULE 2 AI PLATFORM CONFIGURATION
# Copy this file to .env and configure your local environment credentials.
# NOTE: The portal has built-in offline/developer fallbacks so all features work
# out-of-the-box even before external API keys are configured.
# ==============================================================================

# Flask Session Security
SECRET_KEY=supersecretkey_mitm_secure_2026
FLASK_DEBUG=True
FLASK_RUN_PORT=5000

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///placement.db

# ------------------------------------------------------------------------------
# 1. Firebase Authentication (Google, Email/Password, Phone OTP)
# ------------------------------------------------------------------------------
# Path to your Firebase service account JSON key file (downloaded from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase_service_account.json

# Client-Side Firebase Web Configuration (Optional: for browser SDK initialization)
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=mit-placement-portal.firebaseapp.com
FIREBASE_PROJECT_ID=mit-placement-portal
FIREBASE_STORAGE_BUCKET=mit-placement-portal.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 2. YouTube Data API v3 (Educational Placement Recommendations)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create API Key
# Enable "YouTube Data API v3" in API Library.
# If omitted, the portal automatically uses the curated, verified placement tutorial catalog.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ------------------------------------------------------------------------------
# 3. AI Mock Interview & Evaluation Engine (Google Gemini API)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
# If omitted, the portal uses its built-in expert placement rubric evaluation engine.
GEMINI_API_KEY=your_gemini_api_key_here
